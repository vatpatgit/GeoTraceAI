# --- required ---------------------------------------------------------------------------------------------
JWT_SECRET_KEY=            # >= 32 random characters:  python -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=terratrack
POSTGRES_USER=terratrack

# --- general ----------------------------------------------------------------------------------------------
ENV=development            # development | test | production
API_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ORIGINS=http://localhost:3000
AUTO_MIGRATE=true          # must be false when ENV=production
DEMO_MODE=false            # true allows `python -m app.demo.seed` and shows the demo dataset UI

# --- storage / limits -------------------------------------------------------------------------------------
STORAGE_DIR=./storage
MAX_UPLOAD_MB=2048
MAX_RASTER_PIXELS=64000000
MAX_AOI_KM2=2500

# --- jobs -------------------------------------------------------------------------------------------------
JOB_RUNNER=embedded        # embedded | external (run `python -m app.jobs.worker`) | off
JOB_CONCURRENCY=1

# --- learned model (optional) -----------------------------------------------------------------------------
MODEL_DIR=./models
ML_ROOT=../ML
ML_DEVICE=auto             # auto | cpu | cuda

# --- Sentinel imagery (optional; server-side only, never exposed to the browser) ----------------------------
SENTINEL_PROVIDER=auto     # auto | cdse | sentinel_hub | none
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
SENTINEL_HUB_BASE_URL=https://services.sentinel-hub.com
# For Copernicus Data Space Ecosystem OAuth clients use:
#   SENTINEL_PROVIDER=cdse   (uses the CDSE_* URLs; the same CLIENT_ID/SECRET variables hold the CDSE client)

# --- optional services -------------------------------------------------------------------------------------
LLM_PROVIDER=none          # none | anthropic | openai_compatible | ollama | gemini   (analytics works without it)
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=              # gemini: set LLM_API_KEY and LLM_MODEL=gemini-3.5-flash; ollama default http://localhost:11434 (LLM_PROVIDER=ollama needs only LLM_MODEL, e.g. gemma4:26b)
LLM_TIMEOUT_S=30           # raise (e.g. 300) for a local Ollama model on CPU
FIRMS_MAP_KEY=             # NASA FIRMS wildfire hotspots (free key)
OPENWEATHER_API_KEY=       # OpenWeather Alerts API (https://openweathermap.org/openweather-alerts); needs a plan that includes Alerts. Server-side only.
WEATHER_LOOKAHEAD_HOURS=48 # forecast window per refresh (provider supports up to ~5 days)
WEATHER_REFRESH_MINUTES=0  # >0 enables scheduled refresh of AOIs with monitoring turned on (min 15; embedded job runner)

# --- GeoGuider (AI copilot). It reuses the LLM_* variables above; with LLM_PROVIDER=none it falls back to a built-in command parser.
#     For Gemini or any other OpenAI-compatible endpoint use LLM_PROVIDER=openai_compatible with LLM_BASE_URL / LLM_MODEL / LLM_API_KEY.
GEOGUIDER_ENABLED=true
GEOGUIDER_MAX_AOI_KM2=400        # largest area GeoGuider starts an analysis on without asking the user to narrow it
GEOGUIDER_MAX_PAIRS=3            # separate two-date analyses one confirmation may start
GEOGUIDER_SEARCH_WINDOWS=12      # catalogue sub-searches used to chart a long period
GEOGUIDER_MODEL_ID=oscd-s2-v1    # learned model used for Sentinel-2 pairs (needs PyTorch + the checkpoint)
GEOGUIDER_RATE_PER_MIN=30
GEOCODER_PROVIDER=nominatim      # nominatim | none  (place-name search; OpenStreetMap usage policy: max 1 request/second, set a real User-Agent)
GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT="GeoTraceAI/1.0 (contact: you@example.com)"

# --- Live hazard alerts (earthquakes / fire hotspots / storms near saved AOIs); see docs/HAZARD_ALERTS.md
HAZARD_FEED_PROVIDER=osiris
HAZARD_FEED_URL=https://osirisai.live/api
HAZARD_REFRESH_MINUTES=0         # >0 (min 2) enables the server-side scheduler; the web app also checks every 2 minutes while open
HAZARD_MIN_REFRESH_S=60
HAZARD_QUAKE_MIN_MAG=4.0
HAZARD_QUAKE_RADIUS_KM=300
HAZARD_FIRE_RADIUS_KM=25
HAZARD_STORM_RADIUS_KM=500
