# --- required ---------------------------------------------------------------------------------------------
JWT_SECRET_KEY=            # >= 32 random characters:  python -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=terratrack
POSTGRES_USER=terratrack

# --- general ----------------------------------------------------------------------------------------------
ENV=development            # development | test | production
API_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ORIGINS=http://localhost:3000
AUTO_MIGRATE=true          # must be false when ENV=production
DEMO_MODE=false            # true allows `python -m app.demo.seed` and shows the demo dataset UI

# --- storage / limits -------------------------------------------------------------------------------------
STORAGE_DIR=./storage
MAX_UPLOAD_MB=2048
MAX_RASTER_PIXELS=64000000
MAX_AOI_KM2=2500

# --- jobs -------------------------------------------------------------------------------------------------
JOB_RUNNER=embedded        # embedded | external (run `python -m app.jobs.worker`) | off
JOB_CONCURRENCY=1

# --- learned model (optional) -----------------------------------------------------------------------------
MODEL_DIR=./models
ML_ROOT=../ML
ML_DEVICE=auto             # auto | cpu | cuda

# --- Sentinel imagery (optional; server-side only, never exposed to the browser) ----------------------------
SENTINEL_PROVIDER=auto     # auto | cdse | sentinel_hub | none
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
SENTINEL_HUB_BASE_URL=https://services.sentinel-hub.com
# For Copernicus Data Space Ecosystem OAuth clients use:
#   SENTINEL_PROVIDER=cdse   (uses the CDSE_* URLs; the same CLIENT_ID/SECRET variables hold the CDSE client)

# --- optional services -------------------------------------------------------------------------------------
LLM_PROVIDER=none          # none | anthropic | openai_compatible   (analytics works without it)
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
FIRMS_MAP_KEY=             # NASA FIRMS wildfire hotspots (free key)
OPENWEATHER_API_KEY=       # OpenWeather Alerts API (https://openweathermap.org/openweather-alerts); needs a plan that includes Alerts. Server-side only.
WEATHER_LOOKAHEAD_HOURS=48 # forecast window per refresh (provider supports up to ~5 days)
WEATHER_REFRESH_MINUTES=0  # >0 enables scheduled refresh of AOIs with monitoring turned on (min 15; embedded job runner)
