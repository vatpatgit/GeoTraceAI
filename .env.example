# ---------------------------------------------------------------------------------------------------------------
# Root .env.example: the files below are read by DIFFERENT processes. Never put secrets in NEXT_PUBLIC_* variables
# (they are embedded in the browser bundle). All secrets belong in backend/.env (see backend/.env.example).
# ---------------------------------------------------------------------------------------------------------------

# Frontend (put in .env.local, read by `npm run dev` / `npm run build`):
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Browser tests (optional; see README "Tests"):
#   E2E_BASE_URL, E2E_EMAIL, E2E_PASSWORD, E2E_FIXTURE_DIR, E2E_API_BASE
