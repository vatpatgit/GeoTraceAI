# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage
/test-results/
/playwright-report/

# next.js
/.next/
/out/

# production
/build

# local build output
/.dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local

# editor settings
.vscode/

# ML model assets and datasets
ML/artifacts/
ML/datasets/
*.pth

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts


# GeoTrace runtime data & large model files
backend/storage/
backend/tests/_storage/
backend/models/*.pt
*.pt
backend/.venv/
.pytest_cache/

# Cesium runtime assets are copied from node_modules at dev/build time
/public/cesium/

# browser acceptance fixtures (generated)
.e2e-fixtures/
.playwright-mcp/

# training prediction grids (large, regenerable)
ML/experiments/**/predictions/
